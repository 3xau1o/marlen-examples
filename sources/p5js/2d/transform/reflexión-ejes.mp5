  "lang": "ts",
  "sketch": "function setup() {\n  createCanvas(400, 400);\n  textAlign(CENTER, CENTER);\n}\n\nfunction draw() {\n  background(240);\n  \n  // Líneas divisorias de los cuadrantes\n  stroke(200);\n  line(200, 0, 200, 400);\n  line(0, 200, 400, 200);\n  \n  let tamano = 100;\n\n  // --- CUADRANTE 1: SUPERIOR IZQUIERDO (Original) ---\n  push();\n  translate(100, 100);\n  scale(1, 1); \n  kirby(0, -10, tamano);\n  pop();\n  \n  fill(0);\n  text(\"Original\\nscale(1, 1)\", 100, 180);\n\n  // --- CUADRANTE 2: SUPERIOR DERECHO (Reflexión Horizontal) ---\n  push();\n  translate(300, 100);\n  scale(-1, 1); // Invierte el eje X\n  kirby(0, -10, tamano);\n  pop();\n  \n  fill(0);\n  text(\"Reflexión Y (Horizontal)\\nscale(-1, 1)\", 300, 180);\n\n  // --- CUADRANTE 3: INFERIOR IZQUIERDO (Reflexión Vertical) ---\n  push();\n  translate(100, 300);\n  scale(1, -1); // Invierte el eje Y\n  kirby(0, -10, tamano);\n  pop();\n  \n  fill(0);\n  text(\"Reflexión X (Vertical)\\nscale(1, -1)\", 100, 380);\n\n  // --- CUADRANTE 4: INFERIOR DERECHO (Ambos Ejes) ---\n  push();\n  translate(300, 300);\n  scale(-1, -1); // Invierte ambos ejes\n  kirby(0, -10, tamano);\n  pop();\n  \n  fill(0);\n  text(\"Reflexión en Origen\\nscale(-1, -1)\", 300, 380);\n}\n\n// Función Kirby modificada para ser ASIMÉTRICA\nfunction kirby(x, y, s){\n  push();\n  translate(x, y);\n  strokeWeight(s*0.02);\n  stroke(0);\n  \n  // Piernas\n  fill(\"#f56271\");\n  ellipse(s*0.27, s*0.4, s * 0.55, s * 0.3);\n  ellipse(-s*0.27, s*0.4, s * 0.55, s * 0.3);\n  \n  // Brazos (Asimétricos: Izquierdo normal, Derecho levantado)\n  fill(\"#FDCDE7\");\n  ellipse(-s*0.46, 0, s * 0.28, s * 0.25);       // Brazo izquierdo\n  ellipse(s*0.35, -s*0.25, s * 0.25, s * 0.28);  // Brazo derecho ¡Arriba!\n  \n  // Cuerpo principal\n  circle(0, 0, s);\n  \n  // Ojo Izquierdo (Abierto normal)\n  noStroke();\n  fill(0);\n  ellipse(-s*0.12, -s*0.17, s*0.1, s*0.28); // Fondo negro\n  fill(255);\n  ellipse(-s*0.12, -s*0.235, s*0.1, s*0.14); // Brillo\n  noFill();\n  stroke(0);\n  ellipse(-s*0.12, -s*0.17, s*0.1, s*0.28); // Contorno\n  \n  // Ojo Derecho (Asimétrico: Guiño feliz)\n  strokeWeight(s*0.03);\n  arc(s*0.12, -s*0.17, s*0.1, s*0.1, PI, TWO_PI); \n  strokeWeight(s*0.02);\n  \n  // Mejillas\n  noStroke();\n  fill(255, 0, 0, 100);\n  ellipse(s*0.26, -s*0.02, s*0.2, s*0.1);\n  ellipse(-s*0.26, -s*0.02, s*0.2, s*0.1);\n  \n  // Boca\n  noFill();\n  stroke(0);\n  arc(0, s*0.0, s*0.15, s*0.15, PI*0.2, PI*0.8);\n  pop();\n}",
  "notes": "",
