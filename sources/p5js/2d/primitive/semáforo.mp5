  "p5_ver": "2.x",
  "sketch": "// --- Variables Globales ---\n// Estos valores son constantes simples, se pueden asignar aquí arriba\nlet anchoSemaforo = 120;\nlet altoSemaforo = 320;\nlet diametroLuz = 80;\n\n// Declaramos las variables que necesitan cálculos de p5.js\nlet posX, posY, centroX;\nlet rojo, amarillo, verde, grisOscuro;\n\nfunction setup() {\n  createCanvas(400, 500); \n\n  // --- Cálculos que se hacen 1 sola vez ---\n  // Ahora que createCanvas ya se ejecutó, width y height tienen valor\n  posX = width / 2 - anchoSemaforo / 2;\n  posY = height / 2 - altoSemaforo / 2;\n  centroX = width / 2;\n  \n  // Guardamos los colores en la memoria una sola vez\n  rojo = color(255, 0, 0);\n  amarillo = color(255, 200, 0);\n  verde = color(0, 255, 0);\n  grisOscuro = color(50);\n}\n\nfunction draw() {\n  background(220);\n\n  // --- Dibujo del Semáforo ---\n\n  // 1. Poste\n  fill(100);\n  noStroke();\n  rect(width / 2 - 15, posY + altoSemaforo, 30, height);\n\n  // 2. Cuerpo del semáforo\n  fill(grisOscuro);\n  stroke(0);\n  strokeWeight(2);\n  rect(posX, posY, anchoSemaforo, altoSemaforo, 20);\n\n  // 3. Luz Roja (Arriba)\n  fill(rojo);\n  circle(centroX, posY + 70, diametroLuz); \n\n  // 4. Luz Amarilla (Centro)\n  fill(amarillo);\n  circle(centroX, posY + 160, diametroLuz);\n\n  // 5. Luz Verde (Abajo)\n  fill(verde);\n  circle(centroX, posY + 250, diametroLuz);\n}",
