  "sound": false,
  "lang": "ts",
  "sketch": "// 1. MEJORA PRINCIPAL: Centralizamos los datos en una lista de objetos.\n// Si mañana quieres añadir a Júpiter, solo agregas una línea aquí, \n// no tienes que escribir más código de dibujo.\nconst planetas = [\n  { nombre: \"Mercurio\", distancia: 50,  tamano: 15, color: \"#A9A9A9\", velocidad: 4 },\n  { nombre: \"Venus\",    distancia: 80,  tamano: 20, color: \"#DEB887\", velocidad: 1.5 },\n  { nombre: \"Tierra\",   distancia: 120, tamano: 25, color: \"#6495ED\", velocidad: 1, \n    luna: { distancia: 25, tamano: 8, color: \"#C8C8C8\", velocidad: 12 } // La Tierra tiene su satélite\n  },\n  { nombre: \"Marte\",    distancia: 180, tamano: 20, color: \"#BC2732\", velocidad: 0.5 }\n];\n\nlet angulo = 0;\nlet estrellas = []; \n\nfunction setup() {\n  createCanvas(400, 400);\n  angleMode(DEGREES);\n  noStroke(); \n\n  // Generamos las estrellas\n  for (let i = 0; i < 150; i++) {\n    estrellas.push({\n      x: random(width),\n      y: random(height),\n      tamano: random(0.5, 2.5),\n      alfa: random(100, 255)\n    });\n  }\n}\n\nfunction draw() {\n  background(10); \n  \n  // --- FONDO DE ESTRELLAS ---\n  push();\n  noStroke();\n  for (let i = 0; i < estrellas.length; i++) {\n    let estrella = estrellas[i];\n    // Mejora: Usamos constrain() para evitar que la opacidad baje de 50 o suba de 255\n    estrella.alfa = constrain(estrella.alfa + random(-15, 15), 50, 255);\n    fill(255, 255, 255, estrella.alfa);\n    circle(estrella.x, estrella.y, estrella.tamano);\n  }\n  pop();\n\n  translate(width / 2, height / 2); \n\n  // --- LÍNEAS DE ÓRBITA (Bucle) ---\n  push(); \n  noFill(); \n  stroke(200, 60); \n  for (let planeta of planetas) {\n    // Dibujamos todas las órbitas con dos líneas de código\n    circle(0, 0, planeta.distancia * 2); \n  }\n  pop(); \n\n  // --- EL SOL ---\n  fill(\"#FFCC00\"); \n  circle(0, 0, 70); \n\n  // --- DIBUJO DE PLANETAS (Bucle automatizado) ---\n  for (let planeta of planetas) {\n    push();             \n    rotate(angulo * planeta.velocidad); \n    translate(planeta.distancia, 0);   \n    fill(planeta.color); \n    circle(0, 0, planeta.tamano);   \n\n    // Comprobamos si este planeta tiene una luna en sus datos\n    if (planeta.luna) {\n      push();               \n      rotate(angulo * planeta.luna.velocidad);  \n      translate(planeta.luna.distancia, 0);     \n      fill(planeta.luna.color);            \n      circle(0, 0, planeta.luna.tamano);      \n      pop(); \n    }\n    pop(); \n  }\n\n  angulo += 0.5; \n}",
