  "version": "1.0.0",
  "p5_ver": "2.x",
  "sketch": "// Definición e inicialización del estado (POJO)\nlet miPacman = {\n  x: 200,\n  y: 200,\n  rotacion: 0,\n  moviendose: false,\n  tamano: 60,\n  velocidad: 4\n};\n\nlet comida = {\n  x: 0,\n  y: 0,\n  tamano: 15\n};\n\nfunction setup() {\n  createCanvas(400, 400);\n  generarComida();\n}\n\nfunction draw() {\n  background(0);\n\n  actualizarPacman();\n  revisarBordes();   // <--- ¡NUEVA FUNCIÓN AQUÍ!\n  revisarColision();\n  \n  dibujarComida();\n  dibujarPacman();\n}\n\n// Lógica de control de movimiento\nfunction actualizarPacman() {\n  miPacman.moviendose = false;\n\n  if (keyIsDown(RIGHT_ARROW)) {\n    miPacman.x += miPacman.velocidad;\n    miPacman.rotacion = 0;\n    miPacman.moviendose = true;\n  } else if (keyIsDown(DOWN_ARROW)) {\n    miPacman.y += miPacman.velocidad;\n    miPacman.rotacion = HALF_PI;\n    miPacman.moviendose = true;\n  } else if (keyIsDown(LEFT_ARROW)) {\n    miPacman.x -= miPacman.velocidad;\n    miPacman.rotacion = PI;\n    miPacman.moviendose = true;\n  } else if (keyIsDown(UP_ARROW)) {\n    miPacman.y -= miPacman.velocidad;\n    miPacman.rotacion = -HALF_PI;\n    miPacman.moviendose = true;\n  }\n}\n\n// --- NUEVA LÓGICA DE BORDES (Screen Wrap) ---\nfunction revisarBordes() {\n  let radio = miPacman.tamano / 2; // Usamos el radio para que la transición sea suave\n\n  // Eje X (Izquierda / Derecha)\n  if (miPacman.x > width + radio) {\n    miPacman.x = -radio; // Si sale por la derecha, aparece por la izquierda\n  } else if (miPacman.x < -radio) {\n    miPacman.x = width + radio; // Si sale por la izquierda, aparece por la derecha\n  }\n\n  // Eje Y (Arriba / Abajo)\n  if (miPacman.y > height + radio) {\n    miPacman.y = -radio; // Si sale por abajo, aparece por arriba\n  } else if (miPacman.y < -radio) {\n    miPacman.y = height + radio; // Si sale por arriba, aparece por abajo\n  }\n}\n\n// Lógica para detectar si Pac-Man toca la comida\nfunction revisarColision() {\n  let distancia = dist(miPacman.x, miPacman.y, comida.x, comida.y);\n  \n  if (distancia < miPacman.tamano / 2) {\n    generarComida();\n  }\n}\n\n// Lógica para darle una nueva posición a la comida\nfunction generarComida() {\n  comida.x = random(20, width - 20);\n  comida.y = random(20, height - 20);\n}\n\n// Lógica de renderizado\nfunction dibujarComida() {\n  push();\n  fill(255, 100, 100);\n  noStroke();\n  circle(comida.x, comida.y, comida.tamano);\n  pop();\n}\n\nfunction dibujarPacman() {\n  let aperturaBoca = miPacman.moviendose ? abs(sin(frameCount * 0.15)) * 0.2 : 0.1;\n\n  push();\n  translate(miPacman.x, miPacman.y);\n  rotate(miPacman.rotacion);\n  \n  fill(255, 255, 0);\n  noStroke();\n  \n  arc(0, 0, miPacman.tamano, miPacman.tamano, aperturaBoca * PI, (2 - aperturaBoca) * PI, PIE);\n  pop();\n}",
  "notes": "",
