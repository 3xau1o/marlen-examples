{
  "version": "1.0.0",
  "p5_ver": "2.x",
  "sketch": "// --- CONFIGURACIÓN GLOBAL ---\nlet sueloY = 340; // Suelo más bajo para dar espacio a la interfaz superior\nlet gravedad = 1; \n\n// --- OBJETOS ---\nlet mario = {\n  x: 66, \n  y: 0,\n  velY: 0,\n  fuerzaSalto: -20, \n  estaSaltando: false,\n  direccion: 1,\n  escala: 1.0,\n  cronometroPoder: 0,\n  imgReposo: null,\n  imgSalto: null\n};\n\nlet hongo = {\n  x: 0,\n  y: 0,\n  img: null\n};\n\nlet enemigo = {\n  x: 333, \n  y: 0,\n  dir: -1,\n  vivo: true,\n  timer: 0,\n  img: null\n};\n\nasync function setup() {\n  createCanvas(400, 400); \n  imageMode(CENTER);\n  noStroke();\n\n  console.log('Cargando assets...');\n\n  mario.imgReposo = await loadImage('mario.png');\n  mario.imgSalto = await loadImage('mario-salto.png');\n  hongo.img = await loadImage('mushroom.png');\n  enemigo.img = await loadImage('goomba.gif');\n\n  mario.y = sueloY;\n  enemigo.y = sueloY;\n  posicionarHongo();\n}\n\nfunction draw() {\n  background(135, 206, 235); // Cielo azul\n\n  // 1. DIBUJAR SUELO\n  fill(34, 139, 34);\n  rect(0, sueloY, width, height - sueloY);\n\n  // 2. LEYENDA DE CONTROLES (Info Legend)\n  fill(0, 0, 0, 100); // Caja negra semitransparente\n  rect(10, 10, 380, 40, 8); // x, y, ancho, alto, bordes redondeados\n  fill(255);\n  textAlign(CENTER, CENTER);\n  textSize(14);\n  text(\"CONTROLES: ⬅️ ➡️ Mover | ⬆️ Saltar\", width / 2, 30);\n\n  // 3. LÓGICA DEL HONGO\n  image(hongo.img, hongo.x, sueloY - 11, 21, 21);\n\n  if (dist(mario.x, mario.y, hongo.x, sueloY) < 27) {\n    mario.escala = 1.5;\n    mario.cronometroPoder = millis();\n    posicionarHongo();\n  }\n\n  // Si pasaron 5 segundos (5000 ms), Mario pierde el poder\n  if (mario.escala > 1.0 && millis() - mario.cronometroPoder > 5000) {\n    mario.escala = 1.0;\n  }\n\n  // 4. LÓGICA DEL ENEMIGO\n  if (enemigo.vivo) {\n    actualizarEnemigo();\n  } else if (millis() - enemigo.timer > 3000) {\n    enemigo.vivo = true;\n    enemigo.x = random(66, 333); \n  }\n\n  // 5. ENTRADA DE TECLADO\n  if (keyIsDown(LEFT_ARROW)) {\n    mario.x -= 5.3;\n    mario.direccion = -1;\n  }\n  if (keyIsDown(RIGHT_ARROW)) {\n    mario.x += 5.3;\n    mario.direccion = 1;\n  }\n\n  if ((keyIsDown(32) || keyIsDown(UP_ARROW)) && !mario.estaSaltando) {\n    mario.velY = mario.fuerzaSalto;\n    mario.estaSaltando = true;\n  }\n\n  // 6. FÍSICA Y MOVIMIENTO\n  mario.velY += gravedad;\n  mario.y += mario.velY;\n\n  // Límite del suelo\n  if (mario.y > sueloY) {\n    mario.y = sueloY;\n    mario.velY = 0;\n    mario.estaSaltando = false;\n  }\n\n  // Límite de los bordes de la pantalla (¡Nueva mejora!)\n  mario.x = constrain(mario.x, 15, width - 15);\n\n  // 7. DIBUJAR MARIO\n  push();\n  translate(mario.x, mario.y);\n  scale(mario.direccion * mario.escala, mario.escala);\n  let sprite = mario.estaSaltando ? mario.imgSalto : mario.imgReposo;\n  image(sprite, 0, -21, 21, 43);\n  pop();\n}\n\nfunction actualizarEnemigo() {\n  enemigo.x += enemigo.dir * 2;\n  \n  // Rebote en los bordes de la pantalla\n  if (enemigo.x < 27 || enemigo.x > width - 27) enemigo.dir *= -1;\n\n  image(enemigo.img, enemigo.x, sueloY - 11, 21, 21);\n\n  let d = dist(mario.x, mario.y, enemigo.x, sueloY);\n  \n  // Lógica de colisión con el enemigo (¡Mejorada!)\n  if (d < (27 * mario.escala)) {\n    // Si Mario viene cayendo desde arriba (velY > 0)\n    if (mario.velY > 0 && mario.y < sueloY - 7) {\n      enemigo.vivo = false;\n      enemigo.timer = millis();\n      mario.velY = -10.6; // Rebote al aplastar\n    } else {\n      // Si el enemigo toca a Mario por un lado\n      if (mario.escala > 1.0) {\n        // Pierde el poder del hongo\n        mario.escala = 1.0;\n        mario.cronometroPoder = 0;\n        enemigo.x -= enemigo.dir * 40; // Empuja al enemigo atrás para evitar doble daño\n      } else {\n        // Mario muere y reinicia posición\n        mario.x = 66; \n        mario.y = sueloY;\n        mario.velY = 0;\n      }\n    }\n  }\n}\n\nfunction posicionarHongo() {\n  hongo.x = random(40, width - 40);\n}",
  "notes": "",
