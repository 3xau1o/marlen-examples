  "version": "1.0.0",
  "p5_ver": "2.x",
  "sketch": "// --- Variables Globales con Tipado de TypeScript ---\nlet tablero: string[][] = [\n  ['', '', ''],\n  ['', '', ''],\n  ['', '', '']\n];\n\nlet jugadorActual: string = 'X';\nlet w: number; // Ancho de la celda\nlet h: number; // Alto de la celda\nlet offsetY: number = 40; // Margen superior para las instrucciones\n\n// Variables para controlar el estado del juego\nlet estadoJuego: 'jugando' | 'terminado' = 'jugando';\nlet ganador: string | null = null;\nlet posLineaGanadora: { x1: number, y1: number, x2: number, y2: number } | null = null;\n\nfunction setup(): void {\n  createCanvas(400, 440);\n  w = width / 3;\n  h = (height - offsetY) / 3;\n}\n\nfunction draw(): void {\n  background(255);\n\n  // --- Instrucciones en pantalla ---\n  fill(0);\n  noStroke();\n  textSize(16);\n  textAlign(CENTER, CENTER);\n  \n  // Cambiar el texto indicando que deben hacer clic para reiniciar\n  if (estadoJuego === 'jugando') {\n    text(`Turno del jugador: ${jugadorActual}`, width / 2, offsetY / 2);\n  } else if (ganador === 'empate') {\n    text(\"¡Es un empate! Haz clic para reiniciar.\", width / 2, offsetY / 2);\n  } else {\n    text(`¡El jugador ${ganador} gana! Haz clic para reiniciar.`, width / 2, offsetY / 2);\n  }\n\n  // --- Dibujo del Juego ---\n  dibujarRejilla();\n\n  for (let i = 0; i < 3; i++) {\n    for (let j = 0; j < 3; j++) {\n      let x: number = w * j + w / 2;\n      let y: number = h * i + h / 2 + offsetY;\n      let lugar: string = tablero[i][j];\n      \n      if (lugar === 'X') {\n        dibujarX(x, y);\n      } else if (lugar === 'O') {\n        dibujarO(x, y);\n      }\n    }\n  }\n\n  // Dibujar la línea ganadora si alguien ganó\n  if (posLineaGanadora !== null) {\n    stroke(0, 200, 0); // Línea verde para el ganador\n    strokeWeight(8);\n    line(posLineaGanadora.x1, posLineaGanadora.y1, posLineaGanadora.x2, posLineaGanadora.y2);\n  }\n}\n\nfunction mousePressed(): void {\n  // 1. Si el juego ya terminó, el clic sirve para reiniciar\n  if (estadoJuego === 'terminado') {\n    reiniciarJuego();\n    return; // Salimos de la función para no marcar una casilla accidentalmente\n  }\n\n  // 2. Si el juego sigue activo, procesamos la jugada\n  if (estadoJuego === 'jugando') {\n    if (mouseY > offsetY && mouseY < height && mouseX > 0 && mouseX < width) {\n      let i: number = floor((mouseY - offsetY) / h);\n      let j: number = floor(mouseX / w);\n\n      if (tablero[i][j] === '') {\n        tablero[i][j] = jugadorActual;\n        jugadorActual = (jugadorActual === 'X') ? 'O' : 'X';\n        verificarGanador();\n      }\n    }\n  }\n}\n\nfunction verificarGanador(): void {\n  let ganadorTemp: string | null = null;\n\n  // 1. Revisar Filas\n  for (let i = 0; i < 3; i++) {\n    if (tablero[i][0] !== '' && tablero[i][0] === tablero[i][1] && tablero[i][1] === tablero[i][2]) {\n      ganadorTemp = tablero[i][0];\n      let y = i * h + h / 2 + offsetY;\n      posLineaGanadora = { x1: 0, y1: y, x2: width, y2: y };\n    }\n  }\n\n  // 2. Revisar Columnas\n  for (let j = 0; j < 3; j++) {\n    if (tablero[0][j] !== '' && tablero[0][j] === tablero[1][j] && tablero[1][j] === tablero[2][j]) {\n      ganadorTemp = tablero[0][j];\n      let x = j * w + w / 2;\n      posLineaGanadora = { x1: x, y1: offsetY, x2: x, y2: height };\n    }\n  }\n\n  // 3. Revisar Diagonales\n  if (tablero[0][0] !== '' && tablero[0][0] === tablero[1][1] && tablero[1][1] === tablero[2][2]) {\n    ganadorTemp = tablero[0][0];\n    posLineaGanadora = { x1: 0, y1: offsetY, x2: width, y2: height };\n  }\n  if (tablero[2][0] !== '' && tablero[2][0] === tablero[1][1] && tablero[1][1] === tablero[0][2]) {\n    ganadorTemp = tablero[2][0];\n    posLineaGanadora = { x1: 0, y1: height, x2: width, y2: offsetY };\n  }\n\n  // 4. Revisar si hay empate\n  let espaciosLibres: number = 0;\n  for (let i = 0; i < 3; i++) {\n    for (let j = 0; j < 3; j++) {\n      if (tablero[i][j] === '') espaciosLibres++;\n    }\n  }\n\n  // Actualizar estado del juego sin temporizadores\n  if (ganadorTemp !== null) {\n    estadoJuego = 'terminado';\n    ganador = ganadorTemp;\n  } else if (espaciosLibres === 0) {\n    estadoJuego = 'terminado';\n    ganador = 'empate';\n  }\n}\n\nfunction reiniciarJuego(): void {\n  tablero = [\n    ['', '', ''],\n    ['', '', ''],\n    ['', '', '']\n  ];\n  jugadorActual = 'X';\n  estadoJuego = 'jugando';\n  ganador = null;\n  posLineaGanadora = null;\n}\n\nfunction dibujarRejilla(): void {\n  stroke(0);\n  strokeWeight(4);\n  line(0, offsetY, width, offsetY);\n  line(w, offsetY, w, height);\n  line(w * 2, offsetY, w * 2, height);\n  line(0, h + offsetY, width, h + offsetY);\n  line(0, h * 2 + offsetY, width, h * 2 + offsetY);\n}\n\nfunction dibujarX(x: number, y: number): void {\n  stroke(255, 0, 0); \n  let r: number = w * 0.25;\n  line(x - r, y - r, x + r, y + r);\n  line(x + r, y - r, x - r, y + r);\n}\n\nfunction dibujarO(x: number, y: number): void {\n  stroke(0, 0, 255); \n  noFill();\n  circle(x, y, w * 0.5); \n}",
