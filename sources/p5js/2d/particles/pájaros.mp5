  "version": "1.0.0",
  "p5_ver": "2.x",
  "sketch": "let manada;\n\nfunction setup() {\n  // Ajustado al nuevo tamaño\n  createCanvas(400, 400);\n\n  manada = new Manada();\n\n  // Añadir un conjunto inicial de boids (pájaros) al sistema\n  for (let i = 0; i < 100; i++) {\n    let b = new Boid(width / 2, height / 2);\n    manada.agregarBoid(b);\n  }\n\n  describe(\n    'Un grupo de objetos similares a pájaros, representados por triángulos, moviéndose por el lienzo, modelando un comportamiento de manada.'\n  );\n}\n\nfunction draw() {\n  background(0);\n  manada.ejecutar();\n\n  // --- Instrucciones en la parte superior ---\n  push();\n  colorMode(RGB); // Nos aseguramos de usar RGB para el texto blanco\n  fill(255);\n  noStroke();\n  textSize(14);\n  textAlign(CENTER, TOP);\n  text('Arrastra el ratón para generar nuevos elementos.', width / 2, 10);\n  pop();\n}\n\n// Al arrastrar el ratón, se añade un nuevo boid a la manada\nfunction mouseDragged() {\n  manada.agregarBoid(new Boid(mouseX, mouseY));\n}\n\n// Clase Manada para gestionar el arreglo de todos los boids\nclass Manada {\n  constructor() {\n    // Inicializa el arreglo de boids\n    this.boids = [];\n  }\n\n  ejecutar() {\n    for (let boid of this.boids) {\n      // Pasa la lista completa de boids a cada boid individualmente\n      boid.ejecutar(this.boids);\n    }\n  }\n\n  agregarBoid(b) {\n    this.boids.push(b);\n  }\n}\n\nclass Boid {\n  constructor(x, y) {\n    this.aceleracion = createVector(0, 0);\n    this.velocidad = createVector(random(-1, 1), random(-1, 1));\n    this.posicion = createVector(x, y);\n    this.tamano = 3.0;\n\n    // Velocidad máxima\n    this.velocidadMaxima = 3;\n\n    // Fuerza de giro máxima\n    this.fuerzaMaxima = 0.05;\n    \n    colorMode(HSB);\n    this.color = color(random(256), 255, 255);\n  }\n\n  ejecutar(boids) {\n    this.comportamientoManada(boids);\n    this.actualizar();\n    this.bordes();\n    this.dibujar();\n  }\n\n  aplicarFuerza(fuerza) {\n    // Podríamos añadir masa aquí si quisiéramos: A = F / M\n    this.aceleracion.add(fuerza);\n  }\n\n  // Acumulamos una nueva aceleración cada vez basándonos en tres reglas\n  comportamientoManada(boids) {\n    let separacion = this.separar(boids);\n    let alineacion = this.alinear(boids);\n    let cohesion = this.cohesionar(boids);\n\n    // Damos un peso arbitrario a estas fuerzas\n    separacion.mult(1.5);\n    alineacion.mult(1.0);\n    cohesion.mult(1.0);\n\n    // Sumamos los vectores de fuerza a la aceleración\n    this.aplicarFuerza(separacion);\n    this.aplicarFuerza(alineacion);\n    this.aplicarFuerza(cohesion);\n  }\n\n  // Método para actualizar la ubicación\n  actualizar() {\n    // Actualizar velocidad\n    this.velocidad.add(this.aceleracion);\n\n    // Limitar la velocidad máxima\n    this.velocidad.limit(this.velocidadMaxima);\n    this.posicion.add(this.velocidad);\n\n    // Reiniciar la aceleración a 0 en cada ciclo\n    this.aceleracion.mult(0);\n  }\n\n  // Un método que calcula y aplica una fuerza de dirección hacia un objetivo\n  // DIRECCIÓN = OBJETIVO MENOS VELOCIDAD\n  buscar(objetivo) {\n    // Un vector apuntando desde la ubicación hacia el objetivo\n    let deseado = p5.Vector.sub(objetivo, this.posicion);\n\n    // Normalizar el vector deseado y escalarlo a la velocidad máxima\n    deseado.normalize();\n    deseado.mult(this.velocidadMaxima);\n\n    // Dirección = Deseado menos Velocidad\n    let direccion = p5.Vector.sub(deseado, this.velocidad);\n\n    // Limitar a la fuerza de dirección máxima\n    direccion.limit(this.fuerzaMaxima);\n    return direccion;\n  }\n\n  dibujar() {\n    // Dibuja un triángulo rotado en la dirección de la velocidad\n    let theta = this.velocidad.heading() + radians(90);\n    fill(this.color);\n    stroke(255);\n    push();\n    translate(this.posicion.x, this.posicion.y);\n    rotate(theta);\n    beginShape();\n    vertex(0, -this.tamano * 2);\n    vertex(-this.tamano, this.tamano * 2);\n    vertex(this.tamano, this.tamano * 2);\n    endShape(CLOSE);\n    pop();\n  }\n\n  // Reaparición en los bordes (Wraparound)\n  bordes() {\n    if (this.posicion.x < -this.tamano) {\n      this.posicion.x = width + this.tamano;\n    }\n    if (this.posicion.y < -this.tamano) {\n      this.posicion.y = height + this.tamano;\n    }\n    if (this.posicion.x > width + this.tamano) {\n      this.posicion.x = -this.tamano;\n    }\n    if (this.posicion.y > height + this.tamano) {\n      this.posicion.y = -this.tamano;\n    }\n  }\n\n  // Separación\n  // El método revisa los boids cercanos y se aleja de ellos\n  separar(boids) {\n    let separacionDeseada = 25.0;\n    let direccion = createVector(0, 0);\n    let cantidad = 0;\n\n    // Por cada boid en el sistema, revisa si está demasiado cerca\n    for (let boid of boids) {\n      let distanciaAlVecino = p5.Vector.dist(this.posicion, boid.posicion);\n\n      // Si la distancia es mayor a 0 y menor a una cantidad arbitraria (es 0 cuando eres tú mismo)\n      if (distanciaAlVecino > 0 && distanciaAlVecino < separacionDeseada) {\n        // Calcula un vector que apunte alejándose del vecino\n        let diferencia = p5.Vector.sub(this.posicion, boid.posicion);\n        diferencia.normalize();\n\n        // Escala por la distancia\n        diferencia.div(distanciaAlVecino);\n        direccion.add(diferencia);\n\n        // Lleva la cuenta de cuántos hay\n        cantidad++;\n      }\n    }\n\n    // Promedio -- divide por la cantidad\n    if (cantidad > 0) {\n      direccion.div(cantidad);\n    }\n\n    // Siempre que el vector sea mayor a 0\n    if (direccion.mag() > 0) {\n      // Implementa Reynolds: Dirección = Deseado - Velocidad\n      direccion.normalize();\n      direccion.mult(this.velocidadMaxima);\n      direccion.sub(this.velocidad);\n      direccion.limit(this.fuerzaMaxima);\n    }\n    return direccion;\n  }\n\n  // Alineación\n  // Por cada boid cercano, calcula la velocidad promedio\n  alinear(boids) {\n    let distanciaVecino = 50;\n    let suma = createVector(0, 0);\n    let cantidad = 0;\n    for (let i = 0; i < boids.length; i++) {\n      let d = p5.Vector.dist(this.posicion, boids[i].posicion);\n      if (d > 0 && d < distanciaVecino) {\n        suma.add(boids[i].velocidad);\n        cantidad++;\n      }\n    }\n    if (cantidad > 0) {\n      suma.div(cantidad);\n      suma.normalize();\n      suma.mult(this.velocidadMaxima);\n      let direccion = p5.Vector.sub(suma, this.velocidad);\n      direccion.limit(this.fuerzaMaxima);\n      return direccion;\n    } else {\n      return createVector(0, 0);\n    }\n  }\n\n  // Cohesión\n  // Calcula un vector de dirección hacia la posición promedio (el centro) de todos los boids cercanos\n  cohesionar(boids) {\n    let distanciaVecino = 50;\n    let suma = createVector(0, 0); // Empieza con un vector vacío para acumular las ubicaciones\n    let cantidad = 0;\n    for (let i = 0; i < boids.length; i++) {\n      let d = p5.Vector.dist(this.posicion, boids[i].posicion);\n      if (d > 0 && d < distanciaVecino) {\n        suma.add(boids[i].posicion); // Suma la ubicación\n        cantidad++;\n      }\n    }\n    if (cantidad > 0) {\n      suma.div(cantidad);\n      return this.buscar(suma); // Dirigirse hacia la ubicación promedio\n    } else {\n      return createVector(0, 0);\n    }\n  }\n} // clase Boid",
