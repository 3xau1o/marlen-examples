{
  "version": 2,
  "projectType": "p5js",
  "lang": "ts",
  "sketch": "function setup() {\n  // Crea un lienzo de 400x400 píxeles\n  createCanvas(400, 400);\n}\n\nfunction draw() {\n  // Fondo gris claro\n  background(220);\n\n  // Configuración de estilo de texto\n  fill(0);\n  noStroke();\n  textAlign(CENTER, CENTER);\n  \n  // Variables para el control del apilado vertical\n  let x = width / 2;\n  let yInicial = height / 2 - 60; // Punto de inicio para el bloque de texto\n  let interlineado = 40;          // Espacio entre cada línea\n\n  // --- Renderizado de textos apilados ---\n\n  textSize(28);\n  text(\"P5.js\", x, yInicial);\n\n  textSize(22);\n  fill(50, 100, 250); // Color azul para resaltar la versión\n  text(\"Versión actual: \" + p5.VERSION, x, yInicial + interlineado);\n\n  fill(0);\n  textSize(14);\n  text(\"Para probar otra versión, cambia su valor\", x, yInicial + (interlineado * 2.5));\n  text(\"en el panel de configuración.\", x, yInicial + (interlineado * 3));\n}\n",
  "notes": "",
  "files": {},
  "preview": "",
  "console": [],
  "settings": {
    "p5Version": "2.x",
    "useMl5": 0,
    "useSound": 0
  }
