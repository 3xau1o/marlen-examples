  "lang": "ts",
  "sketch": "// Arreglo para almacenar los objetos de cada punto (posición y color)\nlet puntos = [];\n// Radio de tolerancia en píxeles para detectar clics cerca de un punto o línea\nlet umbral = 20; \n// Índice del punto que se está arrastrando actualmente (-1 significa ninguno)\nlet indiceArrastrado = -1;\n// Contador global para calcular el color determinista de cada nuevo punto\nlet contadorColor = 0; \n\n/**\n * Crea un nuevo objeto de punto con su posición y un color fijo.\n * Utiliza el ángulo áureo (137.5 grados) para espaciar uniformemente los colores.\n */\nfunction crearPunto(x, y) {\n  // Calculamos un tono único basado en la cantidad de puntos creados históricamente\n  let tonoDeterminista = (contadorColor * 137.5) % 360;\n  contadorColor++; // Incrementamos para que el siguiente punto tenga otro color\n  \n  return {\n    pos: createVector(x, y), // Vector de posición (x, y)\n    tono: tonoDeterminista   // Tono en el espectro HSB (0-360)\n  };\n}\n\nfunction setup() {\n  // Creamos el lienzo con el tamaño solicitado\n  createCanvas(400, 400);\n  \n  // Inicializamos la curva con 3 puntos de referencia\n  puntos.push(crearPunto(100, 200));\n  puntos.push(crearPunto(200, 100));\n  puntos.push(crearPunto(300, 200));\n}\n\nfunction draw() {\n  // Configuramos el fondo en modo RGB estándar\n  colorMode(RGB); \n  background(220);\n  \n  // --- INSTRUCCIONES VISUALES ---\n  fill(80); // Color gris oscuro\n  noStroke();\n  textSize(14);\n  textAlign(CENTER, TOP); // Alineamos al centro horizontal y arriba verticalmente\n  text(\"Haz clic para añadir puntos, arrastra para moverlos.\", width / 2, 15);\n  \n  // --- 1. DIBUJAR LA CURVA ---\n  noFill();\n  stroke(0); // Línea de color negro\n  strokeWeight(2); // Grosor de la línea\n  \n  beginShape();\n  if (puntos.length > 0) {\n    // curveVertex requiere que el primer y último punto se repitan (anclas)\n    curveVertex(puntos[0].pos.x, puntos[0].pos.y);\n    \n    // Dibujamos todos los puntos intermedios\n    for (let i = 0; i < puntos.length; i++) {\n      curveVertex(puntos[i].pos.x, puntos[i].pos.y);\n    }\n    \n    // Ancla final de la curva\n    curveVertex(puntos[puntos.length - 1].pos.x, puntos[puntos.length - 1].pos.y);\n  }\n  endShape();\n  \n  // --- 2. DIBUJAR PUNTOS DE CONTROL ---\n  // Cambiamos al modo HSB (Tono, Saturación, Brillo) para usar los colores guardados\n  colorMode(HSB, 360, 100, 100); \n  \n  for (let i = 0; i < puntos.length; i++) {\n    let tono = puntos[i].tono; // Recuperamos el color específico de este punto\n    \n    // Si el punto actual es el que estamos arrastrando\n    if (i === indiceArrastrado) {\n      stroke(0); // Borde negro para resaltarlo\n      strokeWeight(2);\n      fill(tono, 100, 100); \n      circle(puntos[i].pos.x, puntos[i].pos.y, 14); // Lo dibujamos un poco más grande\n    } else {\n      // Estado normal del punto\n      noStroke();\n      fill(tono, 100, 100); \n      circle(puntos[i].pos.x, puntos[i].pos.y, 10);\n    }\n  }\n}\n\nfunction mousePressed() {\n  // --- PASO 1: Evaluar si se hizo clic sobre un punto existente ---\n  let distanciaMinimaPunto = Infinity;\n  let indicePunto = -1;\n\n  for (let i = 0; i < puntos.length; i++) {\n    let d = dist(mouseX, mouseY, puntos[i].pos.x, puntos[i].pos.y);\n    // Buscamos el punto más cercano al cursor\n    if (d < distanciaMinimaPunto) {\n      distanciaMinimaPunto = d;\n      indicePunto = i;\n    }\n  }\n\n  // Si el clic fue lo suficientemente cerca (dentro del umbral), lo seleccionamos\n  if (distanciaMinimaPunto <= umbral) {\n    indiceArrastrado = indicePunto;\n    return; // Salimos de la función para no crear puntos nuevos\n  } \n\n  // --- PASO 2: Evaluar si se hizo clic sobre la línea (Curva) ---\n  let distanciaMinimaCurva = Infinity;\n  let indiceInsercion = -1;\n  let pasos = 20; // Resolución matemática para detectar clics en la curva\n\n  for (let i = 0; i < puntos.length - 1; i++) {\n    // Definimos los 4 puntos necesarios para calcular la geometría de la curva local\n    let p0 = puntos[Math.max(i - 1, 0)].pos;\n    let p1 = puntos[i].pos;\n    let p2 = puntos[i + 1].pos;\n    let p3 = puntos[Math.min(i + 2, puntos.length - 1)].pos;\n\n    // Evaluamos 'pasos' a lo largo de este segmento de curva\n    for (let j = 0; j <= pasos; j++) {\n      let t = j / pasos;\n      let sx = curvePoint(p0.x, p1.x, p2.x, p3.x, t);\n      let sy = curvePoint(p0.y, p1.y, p2.y, p3.y, t);\n      let d = dist(mouseX, mouseY, sx, sy);\n      \n      // Encontramos el punto más cercano de la curva al ratón\n      if (d < distanciaMinimaCurva) {\n        distanciaMinimaCurva = d;\n        indiceInsercion = i + 1; // Guardamos el índice donde deberíamos insertar el punto\n      }\n    }\n  }\n\n  // Si hicimos clic sobre la línea, insertamos el punto en el medio\n  if (distanciaMinimaCurva <= umbral) {\n    puntos.splice(indiceInsercion, 0, crearPunto(mouseX, mouseY));\n    return; // Salimos de la función\n  }\n\n  // --- PASO 3: Clic en área libre (Extender la curva) ---\n  if (puntos.length > 0) {\n    // Calculamos si el clic está más cerca del primer punto o del último\n    let distanciaInicio = dist(mouseX, mouseY, puntos[0].pos.x, puntos[0].pos.y);\n    let distanciaFin = dist(mouseX, mouseY, puntos[puntos.length - 1].pos.x, puntos[puntos.length - 1].pos.y);\n\n    if (distanciaInicio < distanciaFin) {\n      // Si está más cerca del inicio, lo agregamos al principio del arreglo\n      puntos.unshift(crearPunto(mouseX, mouseY));\n    } else {\n      // Si está más cerca del final, lo agregamos al final del arreglo\n      puntos.push(crearPunto(mouseX, mouseY));\n    }\n  }\n}\n\nfunction mouseDragged() {\n  // Si tenemos un punto seleccionado, actualizamos su posición con el ratón\n  if (indiceArrastrado !== -1) {\n    puntos[indiceArrastrado].pos.x = mouseX;\n    puntos[indiceArrastrado].pos.y = mouseY;\n  }\n}\n\nfunction mouseReleased() {\n  // Al soltar el botón del ratón, deseleccionamos el punto actual\n  indiceArrastrado = -1;\n}",
