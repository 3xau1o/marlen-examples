  "sketch": "let sonido;\n\nasync function setup() {\n  createCanvas(400, 400);\n  textAlign(CENTER, CENTER);\n  console.log('test')\n  // Load the sound using 'await'\n  sonido = await loadSound('doorbell.mp3');\n}\n\nfunction draw() {\n  // 1. Set the background based on whether the sound is playing\n  if (sonido && sonido.isPlaying()) {\n    background(46, 204, 113); // Verde (Emerald)\n  } else {\n    background(231, 76, 60);  // Rojo (Alizarin)\n  }\n  \n  fill(255); // White text color for everything\n  \n  // 2. Draw the version text at the top center\n  textSize(14);\n  // 'VERSION' is a built-in p5.js variable containing the version string\n  text(\"p5.js version: \" + VERSION, width / 2, 30); \n  \n  // 3. Draw the main interaction text in the middle\n  textSize(24);\n  if (sonido && sonido.isPlaying()) {\n    text(\"🔊 SONANDO...\\n(Clic para parar)\", width / 2, height / 2);\n  } else {\n    text(\"🔔 ¡Haz clic aquí!\", width / 2, height / 2);\n  }\n}\n\nfunction mousePressed() {\n  if (sonido) {\n    if (sonido.isPlaying()) {\n      sonido.stop();\n    } else {\n      sonido.play();\n    }\n  }\n}",
