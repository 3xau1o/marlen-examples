  "sketch": "// Variables para los archivos externos\nlet astronauta;\nlet miFuente;\n\nfunction preload() {\n  console.log('Cargando recursos...');\n  // 1. Cargar el modelo 3D\n  astronauta = loadModel('astronaut.obj', true);\n  \n  // 2. Cargar la fuente para poder ver texto en WEBGL\n  // Nota: Necesitas subir un archivo de fuente (ej. 'Roboto-Regular.ttf') a tu proyecto,\n  // tal como lo hiciste con el .obj. Aquí uso una ruta de ejemplo:\n  miFuente = loadFont('CascadiaMono-Regular.otf'); \n}\n\nfunction setup() {\n  createCanvas(400, 400, WEBGL);\n  angleMode(DEGREES);\n  \n  // Configurar la fuente para todo el lienzo\n  textFont(miFuente);\n  textSize(14);\n  textAlign(CENTER, CENTER);\n\n  describe('Nueve figuras 3D en una cuadrícula de 3x3 de 400x400.');\n}\n\nfunction draw() {\n  background(250);\n\n  // ----------------------------------------\n  // FILA 1 (ARRIBA)\n  // ----------------------------------------\n  \n  // Plano (Arriba-Izquierda)\n  dibujarElemento(-125, -125, 'Plano', function() {\n    plane(40);\n  });\n\n  // Cubo (Arriba-Centro)\n  dibujarElemento(0, -125, 'Cubo', function() {\n    box(40);\n  });\n\n  // Cilindro (Arriba-Derecha)\n  dibujarElemento(125, -125, 'Cilindro', function() {\n    cylinder(20, 40);\n  });\n\n  // ----------------------------------------\n  // FILA 2 (MEDIO)\n  // ----------------------------------------\n  \n  // Toroide (Medio-Izquierda)\n  dibujarElemento(-125, 0, 'Toroide', function() {\n    torus(20, 8);\n  });\n\n  // Esfera (Medio-Centro)\n  dibujarElemento(0, 0, 'Esfera', function() {\n    sphere(25);\n  });\n\n  // Elipsoide (Medio-Derecha)\n  dibujarElemento(125, 0, 'Elipsoide', function() {\n    stroke(0); // Borde negro para visualizar el giro\n    ellipsoid(10, 25, 25);\n  });\n\n  // ----------------------------------------\n  // FILA 3 (ABAJO)\n  // ----------------------------------------\n  \n  // Cono (Abajo-Izquierda)\n  dibujarElemento(-125, 125, 'Cono', function() {\n    cone(25, 40);\n  });\n\n  // Pirámide (Abajo-Centro)\n  dibujarElemento(0, 125, 'Pirámide', function() {\n    cone(30, 50, 4); // Detalle de 4 = Pirámide\n  });\n\n  // Astronauta (Abajo-Derecha)\n  dibujarElemento(125, 125, 'Modelo 3D', function() {\n    rotateZ(180); // Invertir para que esté de pie\n    scale(0.4);   // Ajustar escala para 400x400\n    model(astronauta);\n  });\n}\n\n// ----------------------------------------\n// FUNCIONES AUXILIARES (Para mantener el código limpio)\n// ----------------------------------------\n\n// Esta función agrupa el texto, la posición y la rotación para no repetir código\nfunction dibujarElemento(x, y, nombre, dibujarFigura) {\n  push();\n  translate(x, y, 0);\n\n  // 1. Dibujar el texto estático (sin rotar y sin material)\n  push();\n  fill(0); // Texto negro\n  noStroke();\n  text(nombre, 0, 45); // Posicionado debajo de la figura\n  pop();\n\n  // 2. Dibujar la figura rotando y con material\n  push();\n  rotateZ(frameCount);\n  rotateX(frameCount);\n  rotateY(frameCount);\n  normalMaterial(); // Aplica colores según la dirección de las caras\n  dibujarFigura();  // Ejecuta la figura específica\n  pop();\n\n  pop();\n}",
  "notes": "",
