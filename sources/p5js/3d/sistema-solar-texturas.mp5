  "lang": "ts",
  "sketch": "function setup() {\n  createCanvas(400, 400, WEBGL);\n  angleMode(DEGREES)\n  noStroke()\n  shininess(100)\n  specularMaterial(255)\n}\n\nconst distancia_venus = 60\nconst distancia_tierra = 110\nconst distancia_marte = 160\n\nlet tex_sol, tex_venus, tex_tierra, tex_luna, tex_marte\nlet tex_fondo\nfunction preload() {\n  tex_venus = loadImage('venus.jpg')\n  tex_tierra = loadImage('tierra.jpg')\n  tex_luna = loadImage('luna.jpg')\n  tex_marte = loadImage('marte.jpg')\n  tex_sol = loadImage('sol.jpg')\n  tex_fondo = loadImage('estrellas.jpg')\n}\n \nfunction draw() {\n  push()\n  background(10);\n\n  texture(tex_fondo)\n    sphere(1000)\n  pop()\n  orbitControl()\n\n\n  ambientLight(150)\n  pointLight(255, 255, 255, 0, 0, 0)\n\n  rotateX(-30)\n\n  push()\n  rotateX(90)\n  stroke(200, 200, 200)\n  noFill()\n  circle(0, 0, distancia_venus * 2)\n  circle(0, 0, distancia_tierra * 2)\n  circle(0, 0, distancia_marte * 2)\n  pop()\n\n  // Sol, emite luz\n  push()\n  emissiveMaterial(120)\n  texture(tex_sol)\n  sphere(45)\n  pop()\n\n  // Planeta Venus\n  push()\n  // ambientMaterial(222, 184, 135)\n  texture(tex_venus)\n  rotateY(frameCount)\n  translate(\n    distancia_venus, // x\n    0,// y\n    0 // z\n  )\n  sphere(10)\n  pop()\n\n  // Planeta tierra\n  push()\n    // ambientMaterial(50, 120, 255)\n    texture(tex_tierra)\n    rotateY(frameCount*0.9)\n    translate(\n      distancia_tierra, // x\n      0,// y\n      0 // z\n    )\n    sphere(15)\n\n     push()\n      rotateX(90)\n      stroke(200, 200, 200)\n      noFill()\n      circle(0, 0, 30 * 2)\n    pop()\n\n    push()\n      // ambientMaterial(100)\n      texture(tex_luna)\n      rotateY(frameCount * 1.5)\n      translate(\n        30, // x\n        0,// y\n        0 // z\n      )\n      sphere(5)\n    pop()\n\n  pop()\n\n  // Planeta Marte\n  push()\n  // ambientMaterial(222, 50, 0)\n  texture(tex_marte)\n  rotateY(frameCount)\n  translate(\n    distancia_marte, // x\n    0,// y\n    0 // z\n  )\n  sphere(15)\n  pop()\n}\n",
