{
  "m": {
    "l": "ts",
    "e": {
      "k": "p5js",
      "p": {
        "v": "1",
        "sound": false,
        "ml5": false
      }
    }
  },
  "o": {
    "c": {}
  },
  "fs": {
    "k": "tree",
    "v": 0,
    "r": {
      "k": 0,
      "c": {
        "ground.jpg": {
          "k": 1,
          "c": "data:image/jpeg;base64,"
        },
        "wall.jpg": {
          "k": 1,
          "c": "data:image/jpeg;base64,"
        },
        "player.jpg": {
          "k": 1,
          "c": "data:image/jpeg;base64,"
        },
        "index.ts": {
          "k": 1,
          "c": "let groundTex, pelotaText, jugador_textura;\nlet gameOver = false;\n\nfunction preload() {\n  groundTex = loadImage('ground.jpg');\n  pelotaText = loadImage('wall.jpg');\n  jugador_textura = loadImage('player.jpg');\n}\n\nfunction setup() {\n  createCanvas(400, 400, WEBGL);\n  noStroke();\n  textureWrap(REPEAT);\n  angleMode(DEGREES);\n}\n\nlet jugador_x = 0;\nlet pelotas = [];\n\nfunction draw() {\n  // --- EARLY RETURN SI EL JUEGO TERMINA ---\n  if (gameOver) {\n    background(255, 0, 0); // Pantalla roja para indicar Game Over\n    camera(0, -200, 420, 0, 0, -200, 0, 1, 0);\n    \n    dibujarSuelo();\n\n    return; // Aquí se detiene todo\n  }\n\n  orbitControl()\n  // --- LÓGICA NORMAL DEL JUEGO ---\n  background(255);\n  ambientLight(200);\n  directionalLight(255, 255, 255, 0, 1, -1);\n  camera(0, -200, 420, 0, 0, -200, 0, 1, 0);\n\n  if (frameCount % 60 == 0) {\n    pelotas.push({ carril: random([-1, 0, 1]), z: -800 });\n  }\n\n  // Jugador normal\n  push();\n  translate(50 * jugador_x, -20, 0);\n  texture(jugador_textura);\n  scale(1, -2, 1);\n  cone(30, 20, 4);\n  pop();\n\n  // Pelotas y detección de colisión\n  for (let i = pelotas.length - 1; i >= 0; i--) {\n    let p = pelotas[i];\n    p.z += 5;\n\n    push();\n    translate(50 * p.carril, -20, p.z);\n    rotateX(frameCount * -5);\n    texture(pelotaText);\n    sphere(20);\n    pop();\n\n    // Colisión: carril igual y Z cerca de 0\n    if (p.carril === jugador_x && p.z > -20 && p.z < 20) {\n      gameOver = true;\n      pelotas = []; // Elimina todas las bolas inmediatamente\n    }\n\n    if (p.z > 200) pelotas.splice(i, 1);\n  }\n\n  dibujarSuelo();\n}\n\nfunction dibujarSuelo() {\n  texture(groundTex);\n  for (let i = 0; i < 5; i++) {\n    push();\n    translate(0, 0, -i * 200);\n    rotateX(90);\n    plane(200, 200);\n    pop();\n  }\n}\n\nfunction keyPressed() {\n  if (gameOver) {\n    gameOver = false;\n    jugador_x = 0;\n    pelotas = [];\n    return;\n  }\n\n  if (keyCode === LEFT_ARROW) {\n    jugador_x = max(-1, jugador_x - 1);\n  }\n  if (keyCode === RIGHT_ARROW) {\n    jugador_x = min(1, jugador_x + 1);\n  }\n}"
        }
      }
    }
  }
}