  "version": 2,
  "projectType": "threejs",
  "lang": "ts",
  "sketch": "import * as THREE from 'three'\nimport { FBXLoader } from 'three/addons/loaders/FBXLoader.js' // 1. Cambiado a FBXLoader\n\n// 1. Configurar el renderizador webgl\nconst renderer = new THREE.WebGLRenderer({ antialias: true })\nrenderer.setSize(window.innerWidth, window.innerHeight)\ndocument.body.appendChild(renderer.domElement)\n\n// 2. Crear la escena y la cámara\nconst scene = new THREE.Scene()\nconst camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000)\n\n// Alejar la cámara para tener una buena perspectiva\n// Nota: Los modelos de Mixamo suelen ser grandes, puede que necesites ajustar este valor\ncamera.position.z = 150 \n\n// 3. Configuración de iluminación\nscene.add(new THREE.AmbientLight(0xffffff, 0.4))\nconst light = new THREE.DirectionalLight(0xffffff, 1)\nlight.position.set(5, 5, 5)\nscene.add(light)\n\n// Variables globales\nlet modelo_bailarin\nlet mixer // 2. Nuevo: Necesario para reproducir la animación interna\nconst clock = new THREE.Clock() // 3. Nuevo: Para medir el tiempo entre fotogramas\n\n// 4. Cargar el archivo .fbx\nconst loader = new FBXLoader()\nloader.load('Hip Hop Dancing.fbx', (fbx) => {\n  modelo_bailarin = fbx\n  \n  // Bajar el modelo un poco en el eje Y para que quede centrado en la cámara\n  modelo_bailarin.position.y = -40\n  \n  // 5. Configurar la animación\n  if (fbx.animations && fbx.animations.length > 0) {\n    mixer = new THREE.AnimationMixer(fbx)\n    const action = mixer.clipAction(fbx.animations[0]) // Toma la primera animación (el baile)\n    action.play()\n  }\n\n  // Añadir el modelo a la escena\n  scene.add(modelo_bailarin)\n})\n\n// 6. Ajustar el renderizador al cambiar el tamaño de la ventana\nwindow.addEventListener('resize', () => {\n  camera.aspect = window.innerWidth / window.innerHeight\n  camera.updateProjectionMatrix()\n  renderer.setSize(window.innerWidth, window.innerHeight)\n})\n\n// 7. Bucle de animación principal\nfunction animate() {\n  requestAnimationFrame(animate)\n  \n  const delta = clock.getDelta() // Tiempo transcurrido desde el último frame\n  \n  // En lugar de rotar el modelo entero, actualizamos la animación de baile\n  if (mixer) {\n    mixer.update(delta)\n  }\n  \n  // Renderizar el fotograma actual\n  renderer.render(scene, camera)\n}\n\n// Iniciar la animación\nanimate()",
  "notes": "",
